rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------
    function estConnecte() {
      return request.auth != null;
    }

    function profilDe(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function profilExiste(uid) {
      return exists(/databases/$(database)/documents/users/$(uid));
    }

    // Admin = rôle "admin" ET compte actif, lu dans Firestore
    function estAdmin() {
      return estConnecte()
        && profilExiste(request.auth.uid)
        && profilDe(request.auth.uid).role == 'admin'
        && profilDe(request.auth.uid).actif == true;
    }

    function estActif() {
      return estConnecte()
        && profilExiste(request.auth.uid)
        && profilDe(request.auth.uid).actif == true;
    }

    // ---------- Profils utilisateurs ----------
    match /users/{userId} {

      // Création du profil personnel (inchangé)
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll([
                      'nom', 'prenom', 'age', 'email',
                      'photo', 'role', 'actif', 'createdAt'
                    ])
                    && request.resource.data.keys().hasOnly([
                      'nom', 'prenom', 'age', 'email',
                      'photo', 'role', 'actif', 'createdAt'
                    ])
                    && request.resource.data.role == 'user'
                    && request.resource.data.actif == true
                    && request.resource.data.email == request.auth.token.email;

      // Lecture : son propre profil, ou tous les profils si admin
      allow read: if estConnecte()
                  && (request.auth.uid == userId || estAdmin());

      allow update: if
        // (a) l'utilisateur modifie ses infos perso (jamais role/actif)
        (estConnecte()
          && request.auth.uid == userId
          && estActif()
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['nom', 'prenom', 'age', 'photo']))
        ||
        // (b) l'admin modifie UNIQUEMENT "actif" d'un simple utilisateur
        (estAdmin()
          && request.auth.uid != userId
          && resource.data.role == 'user'
          && request.resource.data.actif is bool
          && request.resource.data.diff(resource.data)
             .affectedKeys().hasOnly(['actif']));

      // Jamais de suppression : on désactive
      allow delete: if false;

      // Favoris personnels (réservés aux comptes actifs)
      match /favorites/{movieId} {
        allow read, create, update, delete:
          if estConnecte()
          && request.auth.uid == userId
          && estActif();
      }
    }

    // ---------- Catalogue des films ----------
    match /movies/{movieId} {
      allow read: if true;

      allow create: if estAdmin()
                    && request.resource.data.titre is string
                    && request.resource.data.titre.size() > 0
                    && request.resource.data.titre.size() <= 200;

      allow update, delete: if estAdmin();
    }
  }
}